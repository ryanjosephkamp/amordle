{
  "name": "amordle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "preinstall": "node scripts/install-node24.mjs",
    "predev": "scripts/node24.sh scripts/prepare-public-word-assets.mjs",
    "dev": "scripts/node24.sh node_modules/next/dist/bin/next dev",
    "prebuild": "scripts/node24.sh scripts/prepare-build.mjs",
    "build": "scripts/node24.sh node_modules/next/dist/bin/next build",
    "start": "scripts/node24.sh node_modules/next/dist/bin/next start",
    "format": "scripts/node24.sh node_modules/prettier/bin/prettier.cjs --write public/manifest.webmanifest public/sw.js scripts src tests eslint.config.mjs next.config.ts package.json playwright.config.ts pnpm-workspace.yaml postcss.config.mjs tsconfig.json vitest.browser.config.ts vitest.config.ts",
    "format:check": "scripts/node24.sh node_modules/prettier/bin/prettier.cjs --check public/manifest.webmanifest public/sw.js scripts src tests eslint.config.mjs next.config.ts package.json playwright.config.ts pnpm-workspace.yaml postcss.config.mjs tsconfig.json vitest.browser.config.ts vitest.config.ts",
    "lint": "scripts/node24.sh node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "typecheck": "scripts/node24.sh node_modules/@typescript/native/bin/tsc --noEmit",
    "verify:migrations": "scripts/node24.sh scripts/verify-migrations.mjs",
    "verify:word-assets": "scripts/node24.sh scripts/verify-word-assets.mjs",
    "verify:boundaries": "scripts/node24.sh scripts/scan-boundaries.mjs",
    "verify:apis": "scripts/node24.sh scripts/verify-api-count.mjs",
    "verify:css-tokens": "scripts/node24.sh scripts/verify-css-tokens.mjs",
    "verify:budgets": "scripts/node24.sh scripts/verify-bundle-budgets.mjs",
    "word-data:check-upstream": "scripts/node24.sh scripts/check-word-data-upstream.mjs",
    "word-data:refresh": "scripts/node24.sh scripts/refresh-word-data.mjs",
    "generate:keyboard-manual": "scripts/node24.sh scripts/generate-keyboard-manual.mjs",
    "verify:keyboard-manual": "scripts/node24.sh scripts/generate-keyboard-manual.mjs --check",
    "test:domain": "scripts/node24.sh node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright install chromium firefox webkit",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright scripts/node24.sh node_modules/vitest/vitest.mjs run --config vitest.browser.config.ts",
    "test:e2e:fixture": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright scripts/node24.sh node_modules/playwright/cli.js test --project=fixture-chromium --project=fixture-firefox --project=fixture-webkit",
    "test:e2e:services": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright scripts/node24.sh node_modules/playwright/cli.js test --project=services --workers=1",
    "test:visual": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright scripts/node24.sh node_modules/playwright/cli.js test --project=visual --project=visual-firefox --project=visual-webkit",
    "test:acceptance:local": "pnpm check && pnpm test:domain && pnpm test:browser && pnpm test:e2e:fixture && pnpm test:visual",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm verify:migrations && pnpm verify:word-assets && pnpm verify:keyboard-manual && pnpm verify:boundaries && pnpm verify:apis && pnpm verify:css-tokens && pnpm verify:budgets",
    "generate:word-assets": "scripts/node24.sh scripts/generate-word-assets.mjs",
    "generate:types": "scripts/node24.sh scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "@tanstack/react-query": "5.101.4",
    "geist": "1.7.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-vitals": "6.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "fast-check": "4.9.0",
    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "shadcn": "4.15.0",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vercel": "57.0.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "license": "AGPL-3.0-only"
}
