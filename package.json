{
  "name": "amordle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && node scripts/scan-boundaries.mjs",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e:fixture": "playwright test --project=fixture-chromium --workers=1",
    "test:e2e:services": "playwright test --project=services-serial",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "verify:build": "node scripts/check-build.mjs",
    "verify:parity": "node scripts/verify-parity-registry.mjs --structure",
    "verify:preview-parity": "node scripts/verify-preview-parity.mjs",
    "verify:parity:complete": "node scripts/verify-parity-registry.mjs --complete",
    "verify:preview-environment": "node scripts/require-preview-environment.mjs",
    "verify:rc-environment": "node scripts/require-rc-environment.mjs",
    "test:acceptance:local": "pnpm check && pnpm test && pnpm test:browser && pnpm test:e2e:fixture && pnpm test:visual && pnpm build && pnpm verify:build && pnpm verify:migrations && pnpm verify:parity",
    "test:preview-acceptance": "pnpm verify:preview-environment && pnpm check && pnpm test && pnpm test:browser && pnpm test:e2e:fixture && pnpm test:e2e:services && pnpm test:visual && pnpm build && pnpm verify:build && pnpm verify:migrations && pnpm verify:preview-parity",
    "test:acceptance": "pnpm verify:rc-environment && pnpm check && pnpm test && pnpm test:browser && pnpm test:e2e:fixture && pnpm test:e2e:services && pnpm test:visual && pnpm build && pnpm verify:build && pnpm verify:migrations && pnpm verify:parity:complete",
    "verify:migrations": "node scripts/verify-migrations.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-query": "5.101.4",
    "@vercel/blob": "2.6.1",
    "react": "19.2.8",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.8",
    "react-router": "7.18.1",
    "workbox-window": "7.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/node": "5.8.26",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "fast-check": "4.9.0",
    "globals": "17.7.0",
    "playwright": "1.61.1",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
