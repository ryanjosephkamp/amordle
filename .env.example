# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-browser-safe-publishable-key

# Server-side public aliases
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-browser-safe-publishable-key

# Vercel server-only configuration
CRON_SECRET=replace-with-a-long-random-string
BLOB_READ_WRITE_TOKEN=replace-with-the-dedicated-blob-token

# Node-only real-service E2E configuration
E2E_SUPABASE_URL=https://your-project-ref.supabase.co
E2E_SUPABASE_ANON_KEY=your-browser-safe-publishable-key
E2E_SUPABASE_SERVICE_ROLE_KEY=replace-in-private-local-process-scope-only

# Migration/operator configuration; never expose to browser code
SUPABASE_ACCESS_TOKEN=replace-in-private-operator-process-scope-only
SUPABASE_DB_PASSWORD=replace-in-private-operator-process-scope-only
